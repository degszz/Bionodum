---
const WHATSAPP_MESSAGE = encodeURIComponent('¡Hola Bionodum! Me comunico desde el sitio web. Quisiera consultar sobre sus productos y servicios.');

const WHATSAPP_LINK_1 = `https://wa.me/5492216550559?text=${WHATSAPP_MESSAGE}`;
const WHATSAPP_LINK_2 = `https://wa.me/5492323617024?text=${WHATSAPP_MESSAGE}`;

const whatsappNumbers = [
  {
    number: '+54 9 221 655-0559',
    href: WHATSAPP_LINK_1,
  },
  {
    number: '+54 9 232 617-024',
    href: WHATSAPP_LINK_2,
  },
];

const socialInfo = [
  {
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>`,
    label: 'Instagram',
    value: '@bionodum',
    href: 'https://www.instagram.com/bionodum',
  },
  {
    icon: `<svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>`,
    label: 'LinkedIn',
    value: 'Bionodum Nutrición Animal',
    href: 'https://www.linkedin.com/company/bionodum',
  },
];
---

<section id="contacto" class="py-14 sm:py-24 bg-gray-50">
  <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">

    <!-- Header -->
    <div class="text-center mb-10 sm:mb-16 reveal">
      <span class="inline-block px-4 py-1.5 bg-brand-100 text-brand-700 text-xs sm:text-sm font-semibold rounded-full mb-3 tracking-wide uppercase">
        Contacto
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-gray-900 mb-3 sm:mb-6">
        Hablemos
      </h2>
      <p class="text-sm sm:text-lg text-gray-500 max-w-xl mx-auto">
        Escribinos por WhatsApp y te responderemos a la brevedad.
      </p>
    </div>

    <!-- WhatsApp cards -->
    <div class="grid sm:grid-cols-2 gap-4 sm:gap-6 mb-6 sm:mb-8 reveal">
      {whatsappNumbers.map((wa) => (
        <a
          href={wa.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-4 p-5 sm:p-6 bg-[#25D366] hover:bg-[#1db954] rounded-2xl text-white shadow-md hover:shadow-lg transition-all duration-200 hover:-translate-y-0.5"
        >
          <div class="flex-shrink-0 w-12 h-12 sm:w-14 sm:h-14 bg-white/20 rounded-xl flex items-center justify-center">
            <svg class="w-7 h-7 sm:w-8 sm:h-8" fill="currentColor" viewBox="0 0 24 24">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
            </svg>
          </div>
          <div class="min-w-0 flex-1">
            <div class="font-bold text-base sm:text-lg">WhatsApp</div>
            <div class="text-white/90 text-sm sm:text-base font-medium">{wa.number}</div>
          </div>
          <svg class="w-5 h-5 flex-shrink-0 opacity-60 group-hover:translate-x-1 transition-transform" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      ))}
    </div>

    <!-- Social links -->
    <div class="grid grid-cols-2 gap-3 sm:gap-4 max-w-md mx-auto reveal reveal-delay-1">
      {socialInfo.map(info => (
        <a
          href={info.href}
          target="_blank"
          rel="noopener noreferrer"
          class="group flex items-center gap-3 p-4 bg-white rounded-2xl border border-gray-100 hover:border-brand-200 hover:shadow-md transition-all duration-200"
        >
          <div class="w-8 h-8 bg-brand-50 group-hover:bg-brand-100 rounded-xl flex items-center justify-center text-brand-600 flex-shrink-0 transition-colors duration-200">
            <Fragment set:html={info.icon} />
          </div>
          <div class="min-w-0">
            <div class="text-[10px] text-gray-400 font-medium leading-tight">{info.label}</div>
            <div class="text-xs sm:text-sm font-semibold text-gray-700 truncate">{info.value}</div>
          </div>
        </a>
      ))}
    </div>

  </div>
</section>
