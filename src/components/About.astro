---
const values = [
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4M7.835 4.697a3.42 3.42 0 001.946-.806 3.42 3.42 0 014.438 0 3.42 3.42 0 001.946.806 3.42 3.42 0 013.138 3.138 3.42 3.42 0 00.806 1.946 3.42 3.42 0 010 4.438 3.42 3.42 0 00-.806 1.946 3.42 3.42 0 01-3.138 3.138 3.42 3.42 0 00-1.946.806 3.42 3.42 0 01-4.438 0 3.42 3.42 0 00-1.946-.806 3.42 3.42 0 01-3.138-3.138 3.42 3.42 0 00-.806-1.946 3.42 3.42 0 010-4.438 3.42 3.42 0 00.806-1.946 3.42 3.42 0 013.138-3.138z"/></svg>`,
    title: 'Experiencia',
    description: 'Amplio conocimiento en nutrición y salud animal con años de experiencia en el sector.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>`,
    title: 'Innovación',
    description: 'Productos con tecnología incorporada y un enfoque moderno en las relaciones comerciales.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>`,
    title: 'Equipo profesional',
    description: 'Un equipo multidisciplinario de veterinarios, nutricionistas y especialistas en datos.',
  },
  {
    icon: `<svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"/></svg>`,
    title: 'Resultados medibles',
    description: 'Gestión y análisis de datos productivos para decisiones basadas en evidencia real.',
  },
];
---

<section id="acerca-de" class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-600 text-sm font-semibold rounded-full mb-4 tracking-wide uppercase">
        Acerca de nosotros
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-gray-900 mb-6">
        Quiénes somos
      </h2>
    </div>

    <div class="grid lg:grid-cols-2 gap-16 items-center mb-20">
      <!-- Left: text -->
      <div class="space-y-6 reveal">
        <p class="text-lg text-gray-600 leading-relaxed">
          <strong class="text-gray-900">Bionodum</strong> es un equipo de profesionales en nutrición y salud animal con amplios conocimientos y experiencia. Ofrecemos productos con tecnología incorporada y servicios personalizados con una visión moderna de las nuevas relaciones comerciales.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Operamos como una <strong class="text-brand-600">consultora 360°</strong>, con una alianza estratégica con una empresa del complejo sojero. Nuestro objetivo es ser el aliado estratégico de nuestros clientes vinculados a la producción de proteína animal.
        </p>
        <p class="text-gray-600 leading-relaxed">
          Nos especializamos en los mercados avícola, porcino y rumiante, basándonos en nuestra experiencia y conocimiento del sector para brindar soluciones integrales y personalizadas.
        </p>

        <a
          href="#contacto"
          class="inline-flex items-center gap-2 px-6 py-3 bg-brand-400 hover:bg-brand-500 text-white font-semibold rounded-full transition-all duration-200 hover:-translate-y-0.5 shadow-sm hover:shadow-md"
        >
          Trabajemos juntos
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
          </svg>
        </a>
      </div>

      <!-- Right: visual -->
      <div class="reveal reveal-delay-2">
        <div class="relative">
          <!-- Background shapes -->
          <div class="absolute inset-0 bg-gradient-to-br from-brand-100 to-brand-50 rounded-3xl transform rotate-3"></div>

          <div class="relative bg-gradient-to-br from-brand-800 to-brand-900 rounded-3xl p-8 space-y-6 shadow-2xl">
            <!-- Big icon -->
            <div class="text-center py-4">
              <div class="text-7xl mb-4">🌿</div>
              <h3 class="font-display font-bold text-2xl text-white mb-2">Nuestra Misión</h3>
              <p class="text-white/70 text-sm leading-relaxed">
                Ser el aliado estratégico en la producción de proteína animal, aportando tecnología, conocimiento y servicio personalizado.
              </p>
            </div>

            <div class="border-t border-white/10 pt-6 grid grid-cols-3 gap-4 text-center">
              <div>
                <div class="text-2xl font-bold text-brand-400">Aves</div>
                <div class="text-white/60 text-xs mt-1">Avicultura</div>
              </div>
              <div>
                <div class="text-2xl font-bold text-brand-400">Cerdo</div>
                <div class="text-white/60 text-xs mt-1">Porcicultura</div>
              </div>
              <div>
                <div class="text-2xl font-bold text-brand-400">Res</div>
                <div class="text-white/60 text-xs mt-1">Ganadería</div>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Values grid -->
    <div class="grid sm:grid-cols-2 lg:grid-cols-4 gap-6">
      {values.map((value, i) => (
        <div class={`reveal reveal-delay-${i + 1} group p-6 bg-gray-50 hover:bg-brand-50 rounded-2xl transition-all duration-300 border border-transparent hover:border-brand-200`}>
          <div class="w-12 h-12 bg-brand-100 group-hover:bg-brand-200 rounded-xl flex items-center justify-center text-brand-600 mb-4 transition-colors duration-300">
            <Fragment set:html={value.icon} />
          </div>
          <h3 class="font-semibold text-gray-900 mb-2">{value.title}</h3>
          <p class="text-sm text-gray-600 leading-relaxed">{value.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>
