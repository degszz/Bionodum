---
const mainServices = [
  {
    id: 'analisis',
    number: '01',
    image: '/images/services/analisis.avif',
    title: 'Análisis de Calidad',
    tagline: 'Control exhaustivo de materias primas',
    description:
      'Análisis bromatológicos y verificación de especificaciones técnicas. Garantizamos que cada insumo cumpla los estándares nutricionales y sanitarios más exigentes para una producción confiable.',
    features: [
      'Análisis bromatológicos completos',
      'Control de calidad de materias primas',
      'Verificación de especificaciones técnicas',
      'Trazabilidad de insumos',
      'Certificación de calidad para producción',
      'Informes técnicos detallados',
    ],
  },
  {
    id: 'premezclas',
    number: '02',
    image: '/images/services/premezclas.avif',
    title: 'Premezclas',
    tagline: 'Formulaciones a medida',
    description:
      'Desarrollamos premezclas vitamínico-minerales formuladas según los requerimientos específicos de cada especie, etapa productiva y sistema de producción. Calidad y precisión en cada lote.',
    features: [
      'Formulación por especie y etapa',
      'Vitaminas y minerales de alta pureza',
      'Control de homogeneidad',
      'Adaptación a requerimientos del cliente',
      'Soporte técnico en planta',
      'Trazabilidad de cada lote',
    ],
  },
  {
    id: 'aditivos',
    number: '03',
    image: '/images/services/aditivos.avif',
    title: 'Aditivos',
    tagline: 'Soluciones para potenciar la producción',
    description:
      'Línea completa de aditivos nutricionales y zootécnicos para mejorar la performance, la salud intestinal y la eficiencia productiva. Herramientas modernas basadas en evidencia científica.',
    features: [
      'Promotores de crecimiento no antibióticos',
      'Acidificantes y moduladores intestinales',
      'Antioxidantes y preservantes',
      'Enzimas digestivas',
      'Minerales orgánicos',
      'Asesoramiento técnico en el uso',
    ],
  },
];

const animals = [
  {
    id: 'vaca',
    image: '/images/animals/vaca.avif',
    title: 'Vacunos',
    description:
      'Nutrición para rodeos de leche y carne. Acompañamos al productor con soluciones adaptadas a cada sistema productivo.',
  },
  {
    id: 'cerdo',
    image: '/images/animals/cerdo.avif',
    title: 'Porcinos',
    description:
      'Programas nutricionales para todas las etapas: gestación, lactancia, recría y terminación. Maximizamos eficiencia y salud.',
  },
  {
    id: 'gallina',
    image: '/images/animals/gallina.avif',
    title: 'Aves',
    description:
      'Soluciones para ponedoras, reproductoras y pollos parrilleros. Nutrición balanceada para una producción sana y rentable.',
  },
];
---

<section id="servicios" class="py-24 bg-white overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-600 text-sm font-semibold rounded-full mb-4 tracking-wide uppercase">
        Servicios
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-gray-900 mb-6">
        Nuestros servicios
      </h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        Nos especializamos en tres pilares fundamentales de la nutrición animal: análisis, premezclas y aditivos.
      </p>
    </div>

    <!-- Services list -->
    <div class="space-y-8">
      {mainServices.map((service, i) => (
        <div
          id={service.id}
          class={`reveal reveal-delay-${i + 1} group`}
        >
          <div class="bg-gray-50 hover:bg-white border border-gray-100 hover:border-brand-200 hover:shadow-xl rounded-3xl p-8 lg:p-10 transition-all duration-300">
            <div class="grid lg:grid-cols-[auto_1fr_auto] gap-6 lg:gap-10 items-start">
              <!-- Number + Logo -->
              <div class="flex lg:flex-col items-center lg:items-start gap-4">
                <span class="font-display font-bold text-5xl text-brand-200 group-hover:text-brand-300 transition-colors duration-300 leading-none">
                  {service.number}
                </span>
                <div class="w-20 h-20 sm:w-24 sm:h-24 bg-white border border-brand-100 group-hover:border-brand-300 rounded-2xl flex items-center justify-center p-2 transition-all duration-300 shadow-sm">
                  <img
                    src={service.image}
                    alt={`Logo ${service.title}`}
                    class="w-full h-full object-contain"
                    loading="lazy"
                  />
                </div>
              </div>

              <!-- Content -->
              <div class="space-y-4">
                <div>
                  <p class="text-xs font-semibold text-brand-500 uppercase tracking-wider mb-1">{service.tagline}</p>
                  <h3 class="font-display font-bold text-2xl sm:text-3xl text-gray-900">{service.title}</h3>
                </div>

                <p class="text-gray-600 leading-relaxed">{service.description}</p>

                <ul class="grid sm:grid-cols-2 gap-x-6 gap-y-2">
                  {service.features.map(feat => (
                    <li class="flex items-start gap-2 text-sm text-gray-600">
                      <svg class="w-4 h-4 text-brand-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"/>
                      </svg>
                      {feat}
                    </li>
                  ))}
                </ul>
              </div>

              <!-- CTA -->
              <div class="lg:self-center">
                <a
                  href="#contacto"
                  class="inline-flex items-center gap-2 px-5 py-3 bg-brand-400 hover:bg-brand-500 text-white text-sm font-semibold rounded-full transition-all duration-200 hover:-translate-y-0.5 shadow-sm hover:shadow-md whitespace-nowrap"
                >
                  Solicitar info
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
                  </svg>
                </a>
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- Animals / Species section -->
    <div class="mt-24">
      <div class="text-center mb-12 reveal">
        <span class="inline-block px-4 py-1.5 bg-brand-50 text-brand-600 text-sm font-semibold rounded-full mb-4 tracking-wide uppercase">
          Especies
        </span>
        <h3 class="font-display font-bold text-2xl sm:text-3xl lg:text-4xl text-gray-900 mb-4">
          Soluciones para cada especie
        </h3>
        <p class="text-base sm:text-lg text-gray-500 max-w-2xl mx-auto">
          Adaptamos nuestros servicios a las necesidades específicas de vacunos, porcinos y aves.
        </p>
      </div>

      <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {animals.map((animal, i) => (
          <div
            id={animal.id}
            class={`reveal reveal-delay-${i + 1} group bg-gradient-to-br from-brand-50 to-white border border-brand-100 hover:border-brand-300 hover:shadow-xl rounded-3xl p-8 text-center transition-all duration-300`}
          >
            <div class="w-28 h-28 sm:w-32 sm:h-32 mx-auto mb-5 bg-white rounded-full flex items-center justify-center shadow-sm p-3 group-hover:scale-105 transition-transform duration-300">
              <img
                src={animal.image}
                alt={`Logo ${animal.title}`}
                class="w-full h-full object-contain"
                loading="lazy"
              />
            </div>
            <h4 class="font-display font-bold text-xl sm:text-2xl text-gray-900 mb-2">{animal.title}</h4>
            <p class="text-sm text-gray-600 leading-relaxed">{animal.description}</p>
          </div>
        ))}
      </div>
    </div>

    <!-- Bottom CTA banner -->
    <div class="mt-16 reveal">
      <div class="bg-gradient-to-r from-brand-800 to-brand-600 rounded-3xl p-8 sm:p-12 text-center text-white relative overflow-hidden">
        <div class="absolute inset-0 opacity-10">
          <svg class="w-full h-full" viewBox="0 0 100 100" preserveAspectRatio="xMidYMid slice">
            <defs>
              <pattern id="grid2" width="8" height="8" patternUnits="userSpaceOnUse">
                <path d="M 8 0 L 0 0 0 8" fill="none" stroke="white" stroke-width="0.5"/>
              </pattern>
            </defs>
            <rect width="100%" height="100%" fill="url(#grid2)" />
          </svg>
        </div>
        <div class="relative z-10">
          <h3 class="font-display font-bold text-2xl sm:text-3xl mb-4">¿Listo para optimizar su producción?</h3>
          <p class="text-white/80 mb-8 max-w-xl mx-auto">
            Contactenos hoy y un especialista de nuestro equipo lo asesorará sin compromiso.
          </p>
          <a
            href="#contacto"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white hover:bg-brand-50 text-brand-800 font-bold rounded-full transition-all duration-200 hover:-translate-y-0.5 shadow-lg"
          >
            Hablar con un especialista
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
            </svg>
          </a>
        </div>
      </div>
    </div>
  </div>
</section>
