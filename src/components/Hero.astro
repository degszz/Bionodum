---
---

<section
  id="inicio"
  class="relative h-screen flex items-center overflow-hidden"
>
  <!-- Video background (mobile vertical / desktop horizontal).
       The <source> is injected by the inline script below so that each
       device only downloads ONE file (no double-fetch). -->
  <video
    id="hero-video"
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    class="absolute inset-0 w-full h-full object-cover bg-brand-950"
    aria-hidden="true"
  ></video>
  <script is:inline>
    (function () {
      var v = document.getElementById('hero-video');
      if (!v) return;
      var isMobile = window.matchMedia('(max-width: 767px)').matches;
      var src = isMobile
        ? '/images/hero-video-mobile.mp4'
        : '/images/hero-video.mp4';
      var s = document.createElement('source');
      s.src = src;
      s.type = 'video/mp4';
      v.appendChild(s);
      v.load();
    })();
  </script>

  <!-- Dark overlay with gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-brand-950/80"></div>

  <!-- Animated grain texture overlay -->
  <div class="absolute inset-0 opacity-[0.03] bg-[url('data:image/svg+xml;base64,')]"></div>

  <!-- Decorative glow blobs -->
  <div class="absolute -top-40 -right-40 w-[500px] h-[500px] bg-brand-400/20 rounded-full blur-[120px] animate-pulse"></div>
  <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-brand-500/15 rounded-full blur-[120px]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-[clamp(0.75rem,3vh,3rem)] w-full">
    <div class="grid lg:grid-cols-2 gap-[clamp(1rem,3vh,4rem)] items-center">
      <!-- Text content -->
      <div class="text-white space-y-[clamp(0.5rem,1.5vh,2rem)]">
        <!-- Animated badge -->
        <div class="hero-animate hero-animate-1 inline-flex items-center gap-2 px-[clamp(0.6rem,1.5vh,1.25rem)] py-[clamp(0.3rem,0.9vh,0.65rem)] bg-white/10 border border-white/20 rounded-full text-[clamp(0.75rem,1.6vh,1.125rem)] font-medium backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-400"></span>
          </span>
          Nutrición Animal Profesional
        </div>

        <h1 class="hero-animate hero-animate-2 font-display font-bold text-[clamp(1.8rem,6vh,6rem)] leading-[1.1] tracking-tight">
          Tu aliado estratégico en
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 to-brand-400"> producción animal</span>
        </h1>

        <p class="hero-animate hero-animate-3 text-[clamp(0.875rem,2vh,1.5rem)] text-white/80 leading-relaxed max-w-xl">
          Somos un equipo de profesionales en nutrición y salud animal con amplios conocimientos y experiencia, comprometidos con la eficiencia y rentabilidad de tu negocio.
        </p>

        <!-- Stats row -->
        <div class="hero-animate hero-animate-4 flex flex-wrap gap-[clamp(0.5rem,1.5vh,2rem)]">
          <div class="group">
            <div class="text-[clamp(1.5rem,4vh,3.5rem)] font-bold text-brand-400 group-hover:scale-110 transition-transform duration-300">360°</div>
            <div class="text-[clamp(0.7rem,1.5vh,1rem)] text-white/60">Consultoría integral</div>
          </div>
          <div class="w-px bg-white/20 self-stretch hidden sm:block"></div>
          <div class="group">
            <div class="text-[clamp(1.5rem,4vh,3.5rem)] font-bold text-brand-400 group-hover:scale-110 transition-transform duration-300">3</div>
            <div class="text-[clamp(0.7rem,1.5vh,1rem)] text-white/60">Especies atendidas</div>
          </div>
          <div class="w-px bg-white/20 self-stretch hidden sm:block"></div>
          <div class="group">
            <div class="text-[clamp(1.5rem,4vh,3.5rem)] font-bold text-brand-400 group-hover:scale-110 transition-transform duration-300">GAIA</div>
            <div class="text-[clamp(0.7rem,1.5vh,1rem)] text-white/60">Sistema de gestión</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="hero-animate hero-animate-5 flex flex-wrap gap-[clamp(0.5rem,1vh,1rem)]">
          <a
            href="#servicios"
            class="group inline-flex items-center gap-2 px-[clamp(0.75rem,2vh,2rem)] py-[clamp(0.5rem,1.5vh,1rem)] bg-brand-400 hover:bg-brand-300 text-white text-[clamp(0.875rem,1.8vh,1.125rem)] font-semibold rounded-full transition-all duration-300 shadow-lg shadow-brand-400/25 hover:shadow-brand-400/40 hover:-translate-y-1"
          >
            Nuestros Servicios
            <svg class="w-[clamp(0.75rem,1.5vh,1rem)] h-[clamp(0.75rem,1.5vh,1rem)] group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center gap-2 px-[clamp(0.75rem,2vh,2rem)] py-[clamp(0.5rem,1.5vh,1rem)] bg-white/10 hover:bg-white/20 border border-white/30 hover:border-white/50 text-white text-[clamp(0.875rem,1.8vh,1.125rem)] font-semibold rounded-full transition-all duration-300 backdrop-blur-md hover:-translate-y-1"
          >
            Contactanos
          </a>
        </div>
      </div>

      <!-- Right side: floating card with logo (desktop only) -->
      <div class="hidden lg:flex justify-center items-center hero-animate hero-animate-3">
        <div class="relative">
          <div class="bg-white/[0.08] backdrop-blur-xl border border-white/[0.15] rounded-3xl p-[clamp(1rem,2.5vh,2rem)] space-y-[clamp(0.5rem,1.5vh,1.5rem)] w-[clamp(220px,30vw,320px)] shadow-2xl">
            <div class="flex justify-center">
              <img
                src="/images/logo.avif"
                alt="Bionodum"
                width="100"
                height="100"
                class="h-[clamp(48px,10vh,96px)] w-auto object-contain animate-float drop-shadow-2xl"
              />
            </div>
            <div class="space-y-[clamp(0.25rem,0.8vh,0.75rem)]">
              {[
                { icon: '🐔', label: 'Aves', desc: 'Avicultura de alta performance' },
                { icon: '🐄', label: 'Rumiantes', desc: 'Ganadería bovina y lechera' },
                { icon: '🐷', label: 'Porcinos', desc: 'Porcicultura tecnificada' },
              ].map(item => (
                <div class="flex items-center gap-[clamp(0.5rem,1.5vh,1rem)] p-[clamp(0.5rem,1vh,0.75rem)] bg-white/10 hover:bg-white/[0.15] rounded-xl transition-colors duration-200 cursor-default">
                  <span class="text-[clamp(1.25rem,3.5vh,2rem)]">{item.icon}</span>
                  <div>
                    <div class="text-white font-semibold text-[clamp(0.8rem,1.6vh,1rem)]">{item.label}</div>
                    <div class="text-white/50 text-[clamp(0.65rem,1.3vh,0.875rem)]">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>
          <div class="absolute -top-[clamp(0.5rem,1.5vh,1rem)] -right-[clamp(0.5rem,1.5vh,1rem)] bg-gradient-to-br from-brand-400 to-brand-500 text-white rounded-2xl px-[clamp(0.75rem,1.5vh,1.25rem)] py-[clamp(0.5rem,1vh,0.75rem)] shadow-xl shadow-brand-500/30 animate-float">
            <div class="text-[clamp(0.65rem,1.3vh,0.875rem)] font-medium opacity-90">Socio estratégico</div>
            <div class="text-[clamp(0.875rem,2vh,1.5rem)] font-bold leading-tight">Complejo Soja</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-[clamp(0.5rem,1.5vh,2rem)] left-1/2 -translate-x-1/2 text-white/40 animate-bounce">
    <svg class="w-[clamp(1rem,2vh,1.5rem)] h-[clamp(1rem,2vh,1.5rem)]" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  .hero-animate {
    opacity: 0;
    transform: translateY(30px);
    animation: heroFadeUp 0.8s ease-out forwards;
  }
  .hero-animate-1 { animation-delay: 0.2s; }
  .hero-animate-2 { animation-delay: 0.4s; }
  .hero-animate-3 { animation-delay: 0.6s; }
  .hero-animate-4 { animation-delay: 0.8s; }
  .hero-animate-5 { animation-delay: 1.0s; }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
