---
---

<section
  id="inicio"
  class="relative min-h-screen flex items-center overflow-hidden"
>
  <!-- Video background -->
  <video
    autoplay
    muted
    loop
    playsinline
    preload="auto"
    class="absolute inset-0 w-full h-full object-cover"
    aria-hidden="true"
  >
    <source src="/images/hero-video.mp4" type="video/mp4" />
  </video>

  <!-- Dark overlay with gradient -->
  <div class="absolute inset-0 bg-gradient-to-b from-black/70 via-black/50 to-brand-950/80"></div>

  <!-- Animated grain texture overlay -->
  <div class="absolute inset-0 opacity-[0.03] bg-[url('data:image/svg+xml;base64,')]"></div>

  <!-- Decorative glow blobs -->
  <div class="absolute -top-40 -right-40 w-[500px] h-[500px] bg-brand-400/20 rounded-full blur-[120px] animate-pulse"></div>
  <div class="absolute -bottom-40 -left-40 w-[500px] h-[500px] bg-brand-500/15 rounded-full blur-[120px]"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-24 lg:py-32 w-full">
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-16 items-center">
      <!-- Text content -->
      <div class="text-white space-y-8">
        <!-- Animated badge -->
        <div class="hero-animate hero-animate-1 inline-flex items-center gap-2 px-4 py-2 bg-white/10 border border-white/20 rounded-full text-sm font-medium backdrop-blur-md">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-brand-400 opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-brand-400"></span>
          </span>
          Nutrición Animal Profesional
        </div>

        <h1 class="hero-animate hero-animate-2 font-display font-bold text-4xl sm:text-5xl lg:text-6xl xl:text-7xl leading-[1.1] tracking-tight">
          Tu aliado estratégico en
          <span class="text-transparent bg-clip-text bg-gradient-to-r from-brand-300 to-brand-400"> producción animal</span>
        </h1>

        <p class="hero-animate hero-animate-3 text-lg sm:text-xl text-white/80 leading-relaxed max-w-xl">
          Somos un equipo de profesionales en nutrición y salud animal con amplios conocimientos y experiencia, comprometidos con la eficiencia y rentabilidad de tu negocio.
        </p>

        <!-- Stats row -->
        <div class="hero-animate hero-animate-4 flex flex-wrap gap-8 pt-2">
          <div class="group">
            <div class="text-3xl sm:text-4xl font-bold text-brand-400 group-hover:scale-110 transition-transform duration-300">360°</div>
            <div class="text-sm text-white/60 mt-1">Consultoría integral</div>
          </div>
          <div class="w-px bg-white/20 self-stretch hidden sm:block"></div>
          <div class="group">
            <div class="text-3xl sm:text-4xl font-bold text-brand-400 group-hover:scale-110 transition-transform duration-300">3</div>
            <div class="text-sm text-white/60 mt-1">Especies atendidas</div>
          </div>
          <div class="w-px bg-white/20 self-stretch hidden sm:block"></div>
          <div class="group">
            <div class="text-3xl sm:text-4xl font-bold text-brand-400 group-hover:scale-110 transition-transform duration-300">GAIA</div>
            <div class="text-sm text-white/60 mt-1">Sistema de gestión</div>
          </div>
        </div>

        <!-- CTA Buttons -->
        <div class="hero-animate hero-animate-5 flex flex-wrap gap-4 pt-2">
          <a
            href="#servicios"
            class="group inline-flex items-center gap-2 px-8 py-4 bg-brand-400 hover:bg-brand-300 text-white font-semibold rounded-full transition-all duration-300 shadow-lg shadow-brand-400/25 hover:shadow-brand-400/40 hover:-translate-y-1"
          >
            Nuestros Servicios
            <svg class="w-4 h-4 group-hover:translate-x-1 transition-transform duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
            </svg>
          </a>
          <a
            href="#contacto"
            class="inline-flex items-center gap-2 px-8 py-4 bg-white/10 hover:bg-white/20 border border-white/30 hover:border-white/50 text-white font-semibold rounded-full transition-all duration-300 backdrop-blur-md hover:-translate-y-1"
          >
            Contactanos
          </a>
        </div>
      </div>

      <!-- Right side: floating card with logo -->
      <div class="hidden lg:flex justify-center items-center hero-animate hero-animate-3">
        <div class="relative">
          <!-- Main glass card -->
          <div class="bg-white/[0.08] backdrop-blur-xl border border-white/[0.15] rounded-3xl p-8 space-y-6 w-80 shadow-2xl">
            <!-- Logo -->
            <div class="flex justify-center">
              <img
                src="/images/logo.avif"
                alt="Bionodum"
                width="100"
                height="100"
                class="h-24 w-auto object-contain animate-float drop-shadow-2xl"
              />
            </div>

            <div class="space-y-3">
              {[
                { icon: '🐔', label: 'Aves', desc: 'Avicultura de alta performance' },
                { icon: '🐄', label: 'Rumiantes', desc: 'Ganadería bovina y lechera' },
                { icon: '🐷', label: 'Porcinos', desc: 'Porcicultura tecnificada' },
              ].map(item => (
                <div class="flex items-center gap-4 p-3 bg-white/10 hover:bg-white/[0.15] rounded-xl transition-colors duration-200 cursor-default">
                  <span class="text-2xl">{item.icon}</span>
                  <div>
                    <div class="text-white font-semibold text-sm">{item.label}</div>
                    <div class="text-white/50 text-xs">{item.desc}</div>
                  </div>
                </div>
              ))}
            </div>
          </div>

          <!-- Floating accent badge -->
          <div class="absolute -top-4 -right-4 bg-gradient-to-br from-brand-400 to-brand-500 text-white rounded-2xl px-5 py-3 shadow-xl shadow-brand-500/30 animate-float">
            <div class="text-xs font-medium opacity-90">Socio estratégico</div>
            <div class="text-lg font-bold leading-tight">Complejo Soja</div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-8 left-1/2 -translate-x-1/2 text-white/40 animate-bounce">
    <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" />
    </svg>
  </div>
</section>

<style>
  /* Hero staggered entrance animations */
  .hero-animate {
    opacity: 0;
    transform: translateY(30px);
    animation: heroFadeUp 0.8s ease-out forwards;
  }
  .hero-animate-1 { animation-delay: 0.2s; }
  .hero-animate-2 { animation-delay: 0.4s; }
  .hero-animate-3 { animation-delay: 0.6s; }
  .hero-animate-4 { animation-delay: 0.8s; }
  .hero-animate-5 { animation-delay: 1.0s; }

  @keyframes heroFadeUp {
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }
</style>
