---
const products = [
  {
    name: 'SantOil',
    image: '/images/santoil.avif',
    description: 'Aceite esencial con propiedades antimicrobianas para mejorar la salud intestinal y la conversión alimenticia.',
  },
  {
    name: 'SPC Feed',
    image: '/images/SPCFeed.avif',
    description: 'Concentrado proteico de soja de alta digestibilidad y pureza para dietas de alto rendimiento.',
  },
  {
    name: 'BioD',
    image: '/images/bioD.avif',
    description: 'Solución vitamínica D3 optimizada para mejorar la absorción de calcio y fósforo en todas las especies.',
  },
  {
    name: 'HSMS',
    image: '/images/HSMS.avif',
    description: 'Secuestrante de micotoxinas de alta eficacia para la protección integral del alimento balanceado.',
  },
  {
    name: 'NutriQ',
    image: '/images/nutriQ.avif',
    description: 'Premezcla vitamínico-mineral completa formulada a medida para cada etapa productiva.',
  },
];

const species = [
  {
    emoji: '🐔',
    title: 'Aves',
    subtitle: 'Avicultura',
    description: 'Soluciones nutricionales para pollos parrilleros, ponedoras y reproductoras.',
  },
  {
    emoji: '🐄',
    title: 'Rumiantes',
    subtitle: 'Ganadería bovina y lechera',
    description: 'Programas nutricionales para bovinos de carne y leche.',
  },
  {
    emoji: '🐷',
    title: 'Porcinos',
    subtitle: 'Porcicultura tecnificada',
    description: 'Dietas y aditivos específicos para cada etapa de la producción porcina.',
  },
];
---

<section id="productos" class="py-24 bg-gray-50 overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Section header -->
    <div class="text-center mb-16 reveal">
      <span class="inline-block px-4 py-1.5 bg-brand-100 text-brand-700 text-sm font-semibold rounded-full mb-4 tracking-wide uppercase">
        Productos
      </span>
      <h2 class="font-display font-bold text-3xl sm:text-4xl lg:text-5xl text-gray-900 mb-6">
        Línea de productos
      </h2>
      <p class="text-lg text-gray-500 max-w-2xl mx-auto">
        Productos con tecnología incorporada, seleccionados para cubrir las necesidades nutricionales de cada especie y etapa productiva.
      </p>
    </div>

    <!-- General products image -->
    <div class="reveal mb-16">
      <div class="relative rounded-3xl overflow-hidden shadow-xl group">
        <img
          src="/images/products.avif"
          alt="Línea completa de productos Bionodum"
          class="w-full h-64 sm:h-80 lg:h-96 object-cover group-hover:scale-105 transition-transform duration-700"
          loading="lazy"
        />
        <div class="absolute inset-0 bg-gradient-to-t from-brand-900/80 via-brand-900/30 to-transparent"></div>
        <div class="absolute bottom-0 left-0 right-0 p-6 sm:p-10">
          <h3 class="font-display font-bold text-2xl sm:text-3xl text-white mb-2">
            Tecnología que nutre
          </h3>
          <p class="text-white/80 max-w-lg text-sm sm:text-base">
            Nuestra línea completa de aditivos, ingredientes y premix para nutrición animal de alto rendimiento.
          </p>
        </div>
      </div>
    </div>

    <!-- Product cards: 2 cols mobile, 3 cols md, 5 cols lg -->
    <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6 mb-20">
      {products.map((product, i) => (
        <div
          class={`reveal reveal-delay-${i + 1} product-card group relative bg-white rounded-2xl shadow-sm hover:shadow-2xl border border-gray-100 hover:border-brand-300 overflow-hidden transition-all duration-500 hover:-translate-y-2`}
        >
          <!-- Product image — full height, no crop -->
          <div class="relative overflow-hidden bg-gray-50">
            <img
              src={product.image}
              alt={product.name}
              class="w-full h-auto object-contain group-hover:scale-105 transition-transform duration-700 ease-out"
              loading="lazy"
            />
            <!-- Hover gradient overlay -->
            <div class="absolute inset-0 bg-gradient-to-t from-brand-900/60 via-transparent to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-500"></div>
          </div>

          <!-- Card body -->
          <div class="p-4 sm:p-5">
            <h3 class="font-display font-bold text-base sm:text-lg text-gray-900 group-hover:text-brand-600 transition-colors duration-300 mb-2">
              {product.name}
            </h3>
            <p class="text-gray-500 text-xs sm:text-sm leading-relaxed line-clamp-3">
              {product.description}
            </p>

            <!-- Consult link -->
            <a
              href="#contacto"
              class="inline-flex items-center gap-1 mt-3 text-xs sm:text-sm font-semibold text-brand-600 hover:text-brand-700 group-hover:gap-2 transition-all duration-300"
            >
              Consultar
              <svg class="w-3.5 h-3.5 opacity-0 group-hover:opacity-100 -translate-x-2 group-hover:translate-x-0 transition-all duration-300" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"/>
              </svg>
            </a>
          </div>

          <!-- Glow effect on hover -->
          <div class="absolute -inset-px rounded-2xl opacity-0 group-hover:opacity-100 transition-opacity duration-500 -z-10 bg-gradient-to-br from-brand-200 to-brand-400 blur-xl"></div>
        </div>
      ))}
    </div>

    <!-- Species section -->
    <div class="reveal mb-10">
      <h3 class="font-display font-bold text-2xl sm:text-3xl text-gray-900 text-center mb-4">
        Especies que atendemos
      </h3>
      <p class="text-gray-500 text-center max-w-xl mx-auto">
        Programas nutricionales diseñados específicamente para cada especie y etapa productiva.
      </p>
    </div>

    <div class="grid sm:grid-cols-3 gap-6">
      {species.map((s, i) => (
        <div
          class={`reveal reveal-delay-${i + 1} group bg-white border border-gray-200 hover:border-brand-300 rounded-2xl p-6 hover:shadow-xl transition-all duration-500 hover:-translate-y-1`}
        >
          <div class="text-5xl mb-4 group-hover:scale-110 group-hover:-rotate-3 transition-transform duration-300 inline-block">{s.emoji}</div>
          <h4 class="font-display font-bold text-lg text-gray-900 group-hover:text-brand-600 transition-colors duration-300">{s.title}</h4>
          <p class="text-brand-600 text-xs font-semibold uppercase tracking-wider mb-3">{s.subtitle}</p>
          <p class="text-sm text-gray-500 leading-relaxed">{s.description}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .product-card::before {
    content: '';
    position: absolute;
    top: 0;
    left: -100%;
    width: 100%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(38, 172, 135, 0.04),
      transparent
    );
    transition: left 0.7s ease;
    z-index: 1;
    pointer-events: none;
  }
  .product-card:hover::before {
    left: 100%;
  }
</style>
